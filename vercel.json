{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "help/**",
      "use": "@vercel/static"
    },
    {
      "src": "brand/*",
      "use": "@vercel/static"
    },
    {
      "src": "shots/*",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*.ico",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/cookies",
      "dest": "/cookies.html"
    },
    {
      "src": "/help/?",
      "dest": "/help/index.html"
    },
    {
      "src": "/help/([^/.]+)/?",
      "dest": "/help/$1/index.html"
    },
    {
      "src": "/help/([^/.]+)/([^/.]+)/?",
      "dest": "/help/$1/$2.html"
    }
  ]
}
